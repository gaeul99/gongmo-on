# backend/.env 예시 — 실제 값은 .env에만 둔다(.env는 gitignore됨).

# PostgreSQL(Docker 컨테이너 gongmo-on-db) — backend/docker-compose.yml의 자격 증명과 같다.
DATABASE_URL=postgresql://gongmo:gongmo@localhost:5432/gongmo_on

PORT=3000

# AI 분석 (OpenAI 호환 중계 게이트웨이)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=openai/gpt-5.6-luna

# 수동 마감 점검(POST /api/notifications/run)용 관리자 토큰 — 헤더 x-admin-token
ADMIN_TOKEN=

# 사용자 웹사이트 출처(CORS). 배포 시 실제 주소로 바꾸고 쉼표로 여러 개 나열.
# CLIENT_ORIGIN=https://gongmo-on.example.com

# 이메일 발송(SMTP) — 비어 있으면 이메일을 콘솔·아웃박스에만 기록한다(개발 기본).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=공모온 <no-reply@gongmo-on.app>

# 문자 발송(Solapi) — 현재 코드에서는 사용하지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM=
