{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": ".venv\\Scripts\\python.exe -m app.main",
    "setup": ".venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "venv": "python -m venv .venv && .venv\\Scripts\\python.exe -m pip install --upgrade pip && npm run setup",
    "test": ".venv\\Scripts\\python.exe -m pytest app\\tests -q",
    "typecheck": ".venv\\Scripts\\python.exe -m compileall -q app",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:backup": "node scripts/backup-db.mjs"
  }
}
