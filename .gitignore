# 종속성
node_modules/

# 빌드 산출물
dist/

# 환경 변수 (API 키·토큰 포함 — 절대 커밋 금지)
.env
.env.local
.env.*.local

# 런타임 데이터 (구독자 이메일·전화번호 등 개인정보 포함)
backend/src/data/*.json

# 로그·임시 파일
*.log

# 설계 문서 (로컬에만 보관 — GitLab에는 올리지 않음)
artifacts/

# 발표 자료 (로컬에만 보관 — GitLab에는 올리지 않음)
발표/

# 문서·실행 스크립트 (로컬에만 보관 — GitLab에는 올리지 않음. README는 예외로 포함)
*.md
!/README.md
*.cmd
